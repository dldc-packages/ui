{
  "name": "@dldc/ui",
  "private": true,
  "scripts": {
    "format": "oxfmt .",
    "lint": "oxlint --type-aware .",
    "lint:fix": "oxlint --fix --type-aware .",
    "build": "turbo run build",
    "libs:build": "turbo run build --filter='./libs/*'",
    "all:typecheck": "turbo run typecheck",
    "libs:watch": "turbo watch --filter='./libs/*' build -- --no-clean",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm run libs:build && changeset publish",
    "actions:upgrade": "pnpx actions-up"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "typescript": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "turbo": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72"
}
