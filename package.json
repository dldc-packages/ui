{
  "name": "@dldc/ui",
  "private": true,
  "scripts": {
    "format": "oxfmt .",
    "lint": "oxlint --type-aware .",
    "lint:fix": "oxlint --fix --type-aware .",
    "build": "turbo run build",
    "libs:build": "turbo run build --filter='./libs/*'",
    "all:typecheck": "turbo run typecheck",
    "libs:watch": "turbo watch --filter='./libs/*' build -- --no-clean",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm run libs:build && changeset publish",
    "actions:upgrade": "pnpx actions-up"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@typescript/native-preview": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "turbo": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.32.1+sha512.a706938f0e89ac1456b6563eab4edf1d1faf3368d1191fc5c59790e96dc918e4456ab2e67d613de1043d2e8c81f87303e6b40d4ffeca9df15ef1ad567348f2be"
}
