{
  "name": "@dldc/ui",
  "private": true,
  "scripts": {
    "format": "oxfmt .",
    "lint": "oxlint --type-aware .",
    "lint:fix": "oxlint --fix --type-aware .",
    "build": "turbo run build",
    "libs:build": "turbo run build --filter='./libs/*'",
    "all:typecheck": "turbo run typecheck",
    "libs:watch": "turbo watch --filter='./libs/*' build -- --no-clean",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm run libs:build && changeset publish",
    "actions:upgrade": "pnpx actions-up"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@typescript/native-preview": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "turbo": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
